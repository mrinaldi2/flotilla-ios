// The app's version. Bump it with scripts/bump-version.sh rather than by hand.
//
// MARKETING_VERSION is the release (major.minor.patch), shown as "Version" in
// Settings > About. CURRENT_PROJECT_VERSION is the build number: it goes up by
// one for every build that goes to a phone, so two installs never look alike.

MARKETING_VERSION = 0.10.0
CURRENT_PROJECT_VERSION = 23

// The commit a build was made from, shown in Settings > About. Set on the
// command line (scripts/bump-version.sh prints how); empty in Xcode builds.
FLOTILLA_COMMIT =
